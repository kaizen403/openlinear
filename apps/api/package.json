{
  "name": "@openlinear/api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "bin": "./dist/index.js",
  "exports": {
    ".": "./src/index.ts",
    "./app": "./src/app.ts",
    "./errors": "./src/errors.ts",
    "./sse": "./src/sse.ts",
    "./logger": "./src/logger.ts",
    "./middleware": "./src/middleware/auth.ts",
    "./ownership": "./src/services/ownership.ts",
    "./team-scope": "./src/services/team-scope.ts",
    "./activity": "./src/services/activity.ts"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "node esbuild.config.js",
    "build:pkg": "pkg . --out-path dist",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@openlinear/db": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^3.25.6"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.14.0",
    "@types/supertest": "^6.0.3",
    "@yao-pkg/pkg": "^5.12.0",
    "esbuild": "^0.27.3",
    "supertest": "^7.2.2",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vitest": "^4.0.18"
  },
  "pkg": {
    "scripts": [
      "dist/**/*.js"
    ],
    "assets": [
      "node_modules/.prisma/**/*",
      "node_modules/@prisma/client/**/*",
      "../db/src/**/*"
    ],
    "targets": [
      "node18-macos-x64",
      "node18-macos-arm64",
      "node18-linux-x64"
    ],
    "outputPath": "dist"
  }
}
