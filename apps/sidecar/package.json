{
  "name": "@openlinear/sidecar",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "bin": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "debug": "NODE_OPTIONS='--inspect=0.0.0.0:9229' tsx watch src/index.ts",
    "dev:once": "tsx src/index.ts",
    "build": "node esbuild.config.js",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cartesia/cartesia-js": "^3.1.0",
    "@opencode-ai/sdk": "^1.18.23",
    "@openai/codex-sdk": "0.164.0",
    "@openlinear/api-client": "workspace:*",
    "@openlinear/db": "workspace:*",
    "@openlinear/execution-core": "workspace:*",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.4",
    "express": "^5.2.1",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^3.25.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^20.14.0",
    "@vitest/coverage-v8": "4.0.18",
    "@yao-pkg/pkg": "^5.12.0",
    "esbuild": "^0.27.3",
    "tsx": "^4.19.0",
    "typescript": "^5.4.0",
    "vitest": "^4.0.18"
  }
}
