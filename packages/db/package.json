{
  "name": "@openlinear/db",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "db:generate": "pnpm exec prisma generate",
    "db:push": "pnpm exec prisma db push",
    "db:migrate": "pnpm exec prisma migrate dev",
    "db:migrate:deploy": "pnpm exec prisma migrate deploy",
    "db:migrate:reset": "pnpm exec prisma migrate reset",
    "db:studio": "pnpm exec prisma studio",
    "db:encrypt-tokens": "pnpm --filter @openlinear/api exec tsx ../../packages/db/scripts/encrypt-tokens.ts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "7.4.0"
  },
  "devDependencies": {
    "@types/node": "^25.2.3",
    "prisma": "7.4.0",
    "typescript": "^5.4.0"
  }
}
