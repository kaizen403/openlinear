model TwoFactorChallenge {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
  @@map("two_factor_challenges")
}

/// One-time code that hands a completed GitHub sign-in to the desktop app.
///
/// The cloud API finishes OAuth in the system browser, then redirects to the
/// app's `openlinear://callback` deep link with this code (never a token). The
/// app redeems it once at POST /api/auth/desktop/token with the PKCE verifier
/// it generated before opening the browser; tokens come back in the response
/// body. Only the SHA-256 of the code is stored.
model DesktopAuthCode {
  id            String    @id @default(uuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash      String    @unique
  /// base64url(SHA-256(code_verifier)) — RFC 7636 S256.
  codeChallenge String
  expiresAt     DateTime
  consumedAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
  @@map("desktop_auth_codes")
}

model EmailChangeRequest {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  newEmail   String
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("email_change_requests")
}

model SseTicket {
  id         String    @id @default(uuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())
  // W02b: the Session that minted the ticket. Revoking that session marks
  // its outstanding tickets consumed and closes the streams they opened.
  // NULL only for pre-W02b rows and sessionless test tokens.
  sessionId  String?

  @@index([userId, expiresAt])
  @@map("sse_tickets")
}

// W02b SSO (OIDC) login state. The browser only ever carries the opaque
// `state` (stored as a SHA-256 hash); the PKCE verifier (encrypted at rest)
// and the nonce never leave the server. A row is single-use (`consumedAt`,
// claimed with a conditional UPDATE), expires after 10 minutes and is bound
// to the initiating browser by an HttpOnly cookie whose value is stored as
// `browserBindingHash`. Pruned opportunistically when new flows start.
model SsoAuthState {
  id                    String    @id @default(uuid())
  stateHash             String    @unique
  browserBindingHash    String
  workspaceId           String
  ssoConfigId           String
  issuerUrl             String
  clientId              String
  codeVerifierEncrypted String
  nonce                 String
  redirectUri           String
  expiresAt             DateTime
  consumedAt            DateTime?
  createdAt             DateTime  @default(now())

  @@index([expiresAt])
  @@map("sso_auth_states")
}

// W02b account-level security audit: events that belong to a user rather
// than a workspace (account-wide PAT lifecycle, PAT remediation, refresh-token
// reuse). Workspace-scoped actions stay in `audit_logs`, whose rows cascade
// with their workspace.
model AccountAuditLog {
  id           String   @id @default(uuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  actorId      String?
  action       String
  resourceType String
  resourceId   String
  metadata     Json?
  ipAddress    String?
  createdAt    DateTime @default(now())

  @@index([userId, createdAt])
  @@map("account_audit_logs")
}

// Legacy read-then-write response cache (audit A09: not safe idempotency).
// No longer read or written since W04b (every keyed route uses
// IdempotencyRecord). Kept only until a contract migration drops the table;
// the maintenance job still prunes rows written by older API versions.
model IdempotencyKey {
  id        String   @id @default(uuid())
  userId    String
  routeKey  String
  key       String
  status    Int
  body      Json
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@unique([userId, routeKey, key])
  @@index([expiresAt])
  @@map("idempotency_keys")
}

enum IdempotencyState {
  in_progress
  completed
}

// W04a request idempotency (apps/api/src/services/idempotency.ts). One row per
// (principal, workspace, operation, Idempotency-Key). The reservation, the
// domain mutation and the completed response commit in ONE transaction, so a
// committed row of a transactional operation is always `completed`; a failed
// mutation rolls the reservation back. `in_progress` is reserved for operations
// whose effects cannot share that transaction (W04b) and is answered with
// 409 IDEMPOTENCY_IN_PROGRESS. `requestHash` is the SHA-256 of the canonical
// request; `responseBody` is the exact serialized JSON (CHECK-bounded to 2 MiB).
// Rows are forgotten after `expiresAt` (24 h) and pruned by the maintenance job.
// No FK to users: rows are short-lived and the migration stays lock-free.
model IdempotencyRecord {
  id             String           @id @default(uuid())
  principalId    String
  workspaceId    String
  operation      String
  key            String
  requestHash    String
  state          IdempotencyState @default(in_progress)
  responseStatus Int?
  responseBody   String?
  createdAt      DateTime         @default(now())
  completedAt    DateTime?
  expiresAt      DateTime

  @@unique([principalId, workspaceId, operation, key])
  @@index([expiresAt])
  @@map("idempotency_records")
}

// The ordered realtime stream (W04b; apps/api/src/events). `id` is the SSE
// Last-Event-ID. Rows are inserted only by the sequencer, which moves
// committed `domain_event_outbox` rows here under one advisory lock, so ids
// become visible in commit order: a reader that has seen id N will never see
// a smaller id appear later. Event columns are immutable (trigger
// `domain_events_immutable`); only the relay bookkeeping columns below may be
// updated. Not an audit log: pruned after 48 h (see DomainEventRetention).
model DomainEvent {
  id             BigInt    @id @default(autoincrement())
  type           String
  occurredAt     DateTime  @default(now()) @map("occurred_at")
  actorId        String?   @map("actor_id")
  workspaceId    String?   @map("workspace_id")
  payload        Json
  userIds        String[]  @default([]) @map("user_ids")
  teamIds        String[]  @default([]) @map("team_ids")
  workspaceIds   String[]  @default([]) @map("workspace_ids")
  // W02a resource binding. Audience arrays are routing hints; delivery and
  // replay authorize against these. NULL = legacy row, delivered only to
  // explicitly addressed users.
  resourceType   String?   @map("resource_type")
  projectId      String?   @map("project_id")
  // `domain_event_outbox.id` this event was sequenced from (NULL for rows
  // written before W04b).
  sourceId       BigInt?   @map("source_id")
  // Relay bookkeeping: publication to the fan-out bus. NULL = not yet
  // published. Replay and catch-up readers do not depend on it.
  publishedAt    DateTime? @map("published_at")
  attempts       Int       @default(0)
  nextAttemptAt  DateTime? @map("next_attempt_at")
  leaseOwner     String?   @map("lease_owner")
  leaseExpiresAt DateTime? @map("lease_expires_at")
  lastError      String?   @map("last_error")
  // The relay stopped publishing this event to the bus. It stays in the
  // stream: replay and catch-up still deliver it.
  deadLetteredAt DateTime? @map("dead_lettered_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([publishedAt, id])
  @@index([workspaceId, id])
  @@map("domain_events")
}

// W04b transactional outbox: domain transactions append here (in the same
// transaction as the mutation), so an event commits or rolls back with its
// write. The sequencer moves committed rows into `domain_events` and deletes
// them. Rows are immutable (trigger `domain_event_outbox_immutable`).
model DomainEventOutbox {
  id           BigInt   @id @default(autoincrement())
  type         String
  occurredAt   DateTime @default(now()) @map("occurred_at")
  actorId      String?  @map("actor_id")
  workspaceId  String?  @map("workspace_id")
  payload      Json
  userIds      String[] @default([]) @map("user_ids")
  teamIds      String[] @default([]) @map("team_ids")
  workspaceIds String[] @default([]) @map("workspace_ids")
  resourceType String?  @map("resource_type")
  projectId    String?  @map("project_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("domain_event_outbox")
}

// Single row (id = 1): the highest `domain_events.id` deleted by retention.
// Replay from a cursor below it reports truncated history instead of
// silently skipping pruned events.
model DomainEventRetention {
  id              Int      @id @default(1) @db.SmallInt
  prunedThroughId BigInt   @default(0) @map("pruned_through_id")
  updatedAt       DateTime @default(now()) @map("updated_at")

  @@map("domain_event_retention")
}

// W03a: one execution attempt per sidecar run of a task. The control plane
// owns the claim and every fenced write; the sidecar holds only a run-scoped
// capability (hash stored in execution_capabilities) and no database
// credential. See docs/reports/revamp-2026-10-26/sidecar.md.
enum ExecutionAttemptStatus {
  preparing // started: authorized, snapshot issued; the task row is untouched
  running // claimed: task in_progress, bound to this attempt's provider session
  finishing // terminal task projection written; only logs/run/events/close remain
  closed // capability revoked after a claim
  released // capability revoked before a claim (setup failure or rejected claim)

  @@map("execution_attempt_statuses")
}

model ExecutionAttempt {
  id                   String                 @id @default(uuid())
  taskId               String
  task                 Task                   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId               String
  user                 User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  status               ExecutionAttemptStatus @default(preparing)
  // Initiating credential; re-checked before publication-grade effects.
  authSource           String
  credentialId         String?
  workspaceRestriction String?
  // Immutable bindings captured at start. The claim and every later fenced
  // write are conditional on the task row still matching these values.
  projectId            String?
  teamId               String?
  creatorId            String?
  workspaceId          String?
  repositoryId         String?
  repositoryFullName   String?
  runner               String?
  model                String?
  snapshot             Json
  sessionId            String?
  agentRunId           String?                @unique
  agentRun             AgentRun?              @relation(fields: [agentRunId], references: [id], onDelete: SetNull)
  terminalStatus       Status?
  lastEventSeq         Int                    @default(0)
  cancelRequestedAt    DateTime?
  cancelAcknowledgedAt DateTime?
  heartbeatAt          DateTime               @default(now())
  createdAt            DateTime               @default(now())
  claimedAt            DateTime?
  finishedAt           DateTime?
  closedAt             DateTime?
  closeReason          String?
  // W05a lease sweeper: `recovery_required` (claimed; task released for a
  // retry, work may remain on the device) or `abandoned` (nothing to recover).
  recoveryState        String?
  sweptAt              DateTime?
  // W05a capability rotation for long runs.
  renewedAt            DateTime?
  renewals             Int                    @default(0)
  capabilities         ExecutionCapability[]
  // W10a: brokered git credentials (audit + revocation ledger).
  gitCredentials       ExecutionGitCredential[]
  verifications        ExecutionVerification[]

  @@index([taskId, createdAt])
  @@index([userId, createdAt])
  @@index([status, heartbeatAt])
  @@map("execution_attempts")
}

model ExecutionCapability {
  id          String           @id @default(uuid())
  attemptId   String
  attempt     ExecutionAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  taskId      String
  userId      String
  tokenHash   String           @unique
  tokenPrefix String
  scopes      String[]
  expiresAt   DateTime
  revokedAt   DateTime?
  lastUsedAt  DateTime?
  createdAt   DateTime         @default(now())

  @@index([attemptId])
  @@map("execution_capabilities")
}

/// W10a: one row per git credential issued to an execution attempt. Doubles as
/// the audit record (kind, effect, repository, permissions, fallback reason)
/// and the revocation ledger: an installation token is kept AES-GCM encrypted
/// only until it is revoked at attempt close (or found expired), then cleared.
/// The user's OAuth token is never copied here (`user_oauth` rows carry no
/// token material at all).
model ExecutionGitCredential {
  id                 String           @id @default(uuid())
  attemptId          String
  attempt            ExecutionAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  userId             String
  effect             String
  kind               String
  repositoryFullName String?
  installationId     String?
  permissions        Json?
  fallbackReason     String?
  tokenHash          String?
  encryptedToken     String?
  expiresAt          DateTime?
  revokedAt          DateTime?
  revocationStatus   String?
  createdAt          DateTime         @default(now())

  @@index([attemptId, effect])
  @@map("execution_git_credentials")
}

/// W11a: verification evidence per (attempt, commit, checks hash). The checks
/// were sealed before the agent ran and executed against `commitSha` in a
/// pristine sandboxed checkout; `bodyHash` makes replays idempotent.
model ExecutionVerification {
  id          String           @id @default(uuid())
  attemptId   String
  attempt     ExecutionAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  taskId      String
  userId      String
  projectId   String?
  workspaceId String?
  runId       String
  commitSha   String
  baseSha     String?
  checksHash  String
  policy      String
  status      String
  publication String
  source      String
  runner      String
  environment Json
  checks      Json
  warnings    Json
  detail      String?
  bodyHash    String
  startedAt   DateTime
  finishedAt  DateTime
  createdAt   DateTime         @default(now())

  @@unique([attemptId, commitSha, checksHash])
  @@index([taskId, createdAt])
  @@map("execution_verifications")
}

/// W19b / FE-13: project knowledge — what the team wants every agent run in
/// a project to know (conventions, procedures, pitfalls). People write or
/// approve entries; agents (PATs, chat tools) can only propose. Every change
/// is a new revision (KnowledgeVersion); retraction keeps the history.
/// Active, unexpired entries are sealed into each run's execution snapshot.
model KnowledgeEntry {
  id            String             @id @default(uuid())
  projectId     String
  project       Project            @relation(fields: [projectId], references: [id], onDelete: Cascade)
  /// note | convention | procedure
  kind          String             @default("note")
  title         String
  body          String
  /// proposed | active | retracted
  status        String
  /// user | agent | review_finding
  source        String
  /// Provenance: { taskId?, runId?, reviewId?, findingId?, commit?, chatSessionId? }
  sourceRef     Json?
  /// The latest revision number (KnowledgeVersion.version).
  version       Int                @default(1)
  expiresAt     DateTime?
  createdById   String
  updatedById   String
  approvedById  String?
  approvedAt    DateTime?
  retractedById String?
  retractedAt   DateTime?
  retractReason String?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  versions      KnowledgeVersion[]

  @@index([projectId, status, updatedAt])
  @@map("knowledge_entries")
}

/// W19b: one revision of a knowledge entry (content and status as of that change).
model KnowledgeVersion {
  id         String         @id @default(uuid())
  entryId    String
  entry      KnowledgeEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)
  version    Int
  kind       String
  title      String
  body       String
  status     String
  /// created | edited | approved | retracted | restored
  change     String
  note       String?
  editedById String
  createdAt  DateTime       @default(now())

  @@unique([entryId, version])
  @@map("knowledge_versions")
}

/// FE-14 / W20: outbound webhook endpoint of a project or a workspace. Each
/// matching event is POSTed as signed JSON (services/webhook-delivery.ts).
/// The signing secret is encrypted at rest (`enc:v1:`, TOKEN_ENCRYPTION_KEY)
/// and shown once (create, rotate); `secretPrefix` is for display. See
/// docs/reports/revamp-2026-10-26/webhooks.md.
model WebhookEndpoint {
  id                      String            @id @default(uuid())
  /// project | workspace (exactly one of projectId / workspaceId is set)
  scope                   String
  projectId               String?
  project                 Project?          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  workspaceId             String?
  workspace               Workspace?        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  url                     String
  description             String?
  /// Webhook event types (issue.created, run.failed, ...), at least one.
  eventTypes              String[]          @default([])
  /// openlinear (signed JSON) | slack | discord: the body sent (CHECK; URL rules in the API).
  format                  String            @default("openlinear")
  /// digest.daily: the local hour (0-23) in digestTimezone (IANA); both or neither.
  digestHour              Int?
  digestTimezone          String?
  /// When the next daily digest is due (while on and subscribed to digest.daily).
  digestNextAt            DateTime?
  secretEncrypted         String
  secretPrefix            String
  /// The secret before the last rotation; also signs until it expires.
  previousSecretEncrypted String?
  previousSecretExpiresAt DateTime?
  /// False exactly when disabledAt is set (CHECK).
  active                  Boolean           @default(true)
  consecutiveFailures     Int               @default(0)
  disabledAt              DateTime?
  /// manual | consecutive_failures | owner_lost_access
  disabledReason          String?
  lastSuccessAt           DateTime?
  lastFailureAt           DateTime?
  /// Whose rights the endpoint uses (creator, then whoever last changed it); notified when it is turned off.
  ownerId                 String
  createdById             String
  createdAt               DateTime          @default(now())
  updatedAt               DateTime          @updatedAt
  deliveries              WebhookDelivery[]

  @@index([projectId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("webhook_endpoints")
}

/// FE-14: one event for one endpoint. Unique per (endpoint, event): retries
/// and redeliveries reuse the row, so the receiver always sees the same
/// delivery id (`OpenLinear-Delivery`) for the same event.
model WebhookDelivery {
  id                  String          @id @default(uuid())
  endpointId          String
  endpoint            WebhookEndpoint @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  /// `evt_<stream id>:<type>[:<task id>]`, or `ping_<uuid>` for test pings.
  eventId             String
  eventType           String
  /// The exact JSON body sent on every attempt (bounded).
  payload             String
  /// pending | succeeded | failed | abandoned
  status              String          @default("pending")
  attempts            Int             @default(0)
  /// When the next attempt is due; set exactly while pending.
  nextAttemptAt       DateTime?
  leaseToken          String?
  leaseExpiresAt      DateTime?
  lastAttemptAt       DateTime?
  lastStatusCode      Int?
  lastResponseExcerpt String?
  lastError           String?
  lastDurationMs      Int?
  deliveredAt         DateTime?
  /// Times a person asked for this delivery again.
  redeliveries        Int             @default(0)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  @@unique([endpointId, eventId])
  @@index([endpointId, createdAt, id])
  @@index([status, nextAttemptAt])
  @@map("webhook_deliveries")
}

/// FE-14: single row (id = 1): the last `domain_events.id` the webhook
/// fan-out has turned into deliveries.
model WebhookFanoutCursor {
  id          Int      @id @default(1) @db.SmallInt
  lastEventId BigInt   @default(0) @map("last_event_id")
  updatedAt   DateTime @default(now()) @map("updated_at")

  @@map("webhook_fanout_cursor")
}
