generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma/client"
}

datasource db {
  provider = "postgresql"
}

enum Priority {
  low
  medium
  high
}

enum Status {
  todo
  in_progress
  done
  cancelled
}

enum TeamRole {
  owner
  admin
  member

  @@map("team_roles")
}

enum ProjectStatus {
  planned
  in_progress
  paused
  completed
  cancelled

  @@map("project_statuses")
}

enum WorkspaceRole {
  owner
  admin
  member
  viewer

  @@map("workspace_roles")
}

enum ProjectPermission {
  full
  view
  deny

  @@map("project_permissions")
}

enum AgentRunStatus {
  pending
  running
  succeeded
  failed
  cancelled

  @@map("agent_run_statuses")
}

enum NotificationType {
  mention
  assignment
  status_change
  comment

  @@map("notification_types")
}

enum ChatMessageRole {
  system
  user
  assistant
  tool

  @@map("chat_message_roles")
}

enum ChatToolCallStatus {
  pending
  running
  succeeded
  failed
  cancelled

  @@map("chat_tool_call_statuses")
}

enum ActivityAction {
  task_created
  task_updated
  task_status_changed
  task_assigned
  task_archived
  task_deleted
  comment_created
  comment_updated
  comment_deleted
  project_created
  project_updated
  project_deleted
  team_created
  team_updated
  team_member_added
  team_member_removed
  agent_run_started
  agent_run_completed

  @@map("activity_actions")
}

enum InvitationStatus {
  pending
  accepted
  revoked
  expired

  @@map("invitation_statuses")
}

model Task {
  id          String      @id @default(uuid())
  title       String
  description String?
  priority    Priority    @default(medium)
  status      Status      @default(todo)
  sessionId   String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  labels      TaskLabel[]

  // Execution tracking
  executionStartedAt DateTime?
  executionPausedAt  DateTime?
  executionElapsedMs Int        @default(0)
  executionProgress  Int? // 0-100 estimated progress
  prUrl              String?
  outcome            String? // Summary of what was accomplished
  executionLogs      Json? // Persisted execution log entries
  archived           Boolean    @default(false)
  inboxRead          Boolean    @default(false)
  batchId            String? // Groups tasks executed together in a batch
  teamId             String?
  team               Team?      @relation(fields: [teamId], references: [id], onDelete: SetNull)
  projectId          String?
  project            Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  workspaceId        String?
  workspace          Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  number             Int? // team-scoped issue number
  identifier         String? // e.g. "ENG-1"
  dueDate            DateTime?
  model              String? // Per-task AI model override (format: "provider/model"). Null = use global default.
  agent              String? // Runner id: opencode | codex | claude-code. Null = Project.defaultAgent.

  // Assignment + authorship + hierarchy
  assigneeId String?
  assignee   User?   @relation("assignedTasks", fields: [assigneeId], references: [id], onDelete: SetNull)
  creatorId  String?
  creator    User?   @relation("createdTasks", fields: [creatorId], references: [id], onDelete: SetNull)
  parentId   String?
  parent     Task?   @relation("Subtasks", fields: [parentId], references: [id], onDelete: SetNull)
  subtasks   Task[]  @relation("Subtasks")

  comments          Comment[]
  agentRuns         AgentRun[]
  executionAttempts ExecutionAttempt[]
  activityLogs      ActivityLog[]
  notifications     Notification[]
  taskAssignees     TaskAssignee[]
  planTask           PlanTask?
  // W20: the schedule occurrence that created this task (recurring issues).
  scheduleOccurrence IssueScheduleOccurrence?
  // W17a: "blocked by" relations. `blockedBy` = tasks this one waits on.
  blockedBy          TaskDependency[]         @relation("TaskBlockedBy")
  blocking           TaskDependency[]         @relation("TaskBlocking")

  @@unique([teamId, number])
  @@index([teamId, archived])
  @@index([projectId, archived, createdAt])
  @@index([projectId])
  @@index([workspaceId])
  @@index([status])
  @@index([assigneeId])
  @@index([creatorId])
  // W14 (migration 20261026090000_task_list_indexes): unscoped keyset list
  // order, sub-issue filter + self-FK, and trigram search for `q` (pg_trgm).
  @@index([archived, createdAt, id])
  @@index([parentId])
  @@index([title(ops: raw("gin_trgm_ops"))], map: "tasks_title_trgm_idx", type: Gin)
  @@index([description(ops: raw("gin_trgm_ops"))], map: "tasks_description_trgm_idx", type: Gin)
  @@index([identifier(ops: raw("gin_trgm_ops"))], map: "tasks_identifier_trgm_idx", type: Gin)
  @@map("tasks")
}

/// W17a: `taskId` is blocked by `dependsOnTaskId` until that task is done
/// (cancelled still blocks: a failed run ends as cancelled). Both tasks share a project (or, project-less, a team);
/// acyclic (checked under a per-scope advisory lock); no self-edges (CHECK).
model TaskDependency {
  id              String   @id @default(uuid())
  taskId          String
  task            Task     @relation("TaskBlockedBy", fields: [taskId], references: [id], onDelete: Cascade)
  dependsOnTaskId String
  dependsOnTask   Task     @relation("TaskBlocking", fields: [dependsOnTaskId], references: [id], onDelete: Cascade)
  createdById     String?
  createdAt       DateTime @default(now())

  @@unique([taskId, dependsOnTaskId])
  @@index([dependsOnTaskId])
  @@map("task_dependencies")
}

/// W17b: a reviewable plan for one project. Its revisions are immutable;
/// approving the latest one creates/updates its tasks and the dependencies
/// between them (idempotently). Planning text never runs anything by itself.
model Plan {
  id               String         @id @default(uuid())
  projectId        String
  project          Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title            String
  /// draft (never approved) | approved (latestRevision may be a newer draft) | archived
  status           String         @default("draft")
  latestRevision   Int            @default(1)
  approvedRevision Int?
  createdById      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  revisions        PlanRevision[]
  tasks            PlanTask[]

  @@index([projectId, createdAt])
  @@map("plans")
}

/// W17b: one immutable version of a plan's spec (tasks with acceptance
/// checks, estimates and blockers by key). Only `approvedAt`/`approvedById`
/// are ever written after insert.
model PlanRevision {
  id           String    @id @default(uuid())
  planId       String
  plan         Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  number       Int
  spec         Json
  specHash     String
  note         String?
  createdById  String?
  createdAt    DateTime  @default(now())
  approvedAt   DateTime?
  approvedById String?

  @@unique([planId, number])
  @@map("plan_revisions")
}

/// W17b: which task a plan key became (one plan per task).
model PlanTask {
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  key       String
  taskId    String   @unique
  task      Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([planId, key])
  @@map("plan_tasks")
}

/// W20 / FE-14: a recurring issue. At each slot (cadence + local time in the
/// schedule's IANA `timezone`) the job creates one issue from the template in
/// the project, as `ownerId` (who created or last changed/resumed it). It
/// only creates issues; nothing runs them. `nextRunAt` is the next slot (UTC);
/// paused schedules are never due. CHECK constraints in the migration.
model IssueSchedule {
  id          String                    @id @default(uuid())
  projectId   String
  project     Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String?
  priority    Priority                  @default(medium)
  /// Labels of the project; ones deleted since are left out when an issue is created.
  labelIds    String[]                  @default([])
  /// A member of the project's team; dropped (issue unassigned) if no longer one.
  assigneeId  String?
  /// daily | weekdays | weekly | monthly
  cadence     String
  /// weekly only: 0 (Sunday) – 6 (Saturday)
  weekday     Int?
  /// monthly only: 1 – 28
  dayOfMonth  Int?
  hour        Int
  minute      Int
  timezone    String
  nextRunAt   DateTime
  lastRunAt   DateTime?
  pausedAt    DateTime?
  /// Why the job paused it (e.g. owner_lost_access); null when paused by a person.
  pauseReason String?
  ownerId     String
  createdById String
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  occurrences IssueScheduleOccurrence[]

  @@index([projectId, createdAt])
  @@index([nextRunAt])
  @@map("issue_schedules")
}

/// W20: one slot of a schedule. Unique per (schedule, slot minute), so a slot
/// creates at most one issue however many workers or "run now" clicks race.
model IssueScheduleOccurrence {
  id           String        @id @default(uuid())
  scheduleId   String
  schedule     IssueSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  slotAt       DateTime
  /// scheduled | manual (run now)
  kind         String        @default("scheduled")
  /// created | skipped
  outcome      String
  reason       String?
  /// Earlier missed slots this occurrence stands in for (catch-up after downtime).
  skippedSlots Int           @default(0)
  taskId       String?       @unique
  task         Task?         @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdById  String?
  createdAt    DateTime      @default(now())

  @@unique([scheduleId, slotAt])
  @@map("issue_schedule_occurrences")
}

model Label {
  id        String      @id @default(uuid())
  name      String
  color     String
  priority  Int         @default(0)
  projectId String
  project   Project     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tasks     TaskLabel[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("labels")
}

model TaskLabel {
  taskId  String
  labelId String
  task    Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  label   Label  @relation(fields: [labelId], references: [id], onDelete: Cascade)

  @@id([taskId, labelId])
  // W14: `labelId` filter and the label FK cascade.
  @@index([labelId])
  @@map("task_labels")
}

enum TaskAssigneeRole {
  assignee
  watcher

  @@map("task_assignee_roles")
}

model TaskAssignee {
  id        String           @id @default(uuid())
  taskId    String
  userId    String
  role      TaskAssigneeRole @default(assignee)
  createdAt DateTime         @default(now())
  task      Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([taskId, userId])
  @@index([userId])
  @@index([taskId])
  @@map("task_assignees")
}

model Settings {
  id            String  @id @default(uuid())
  userId        String? @unique
  user          User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  parallelLimit Int     @default(3)

  // Batch execution settings
  maxBatchSize     Int     @default(3)
  queueAutoApprove Boolean @default(false)
  stopOnFailure    Boolean @default(false)
  conflictBehavior String  @default("skip") // "skip" | "fail"
  taskDeletionMode String  @default("archive") // "archive" | "delete"

  // W15a: per-run budgets (null = no limit). Sealed into each attempt's
  // snapshot at start; the sidecar stops a run that reaches either.
  maxRunCostUsd Float?
  maxRunTokens  Int?

  // FE-04: "auto" = runner permission requests are answered by policy;
  // "ask" = the run waits for the user's approval (with a deadline).
  approvalMode String @default("auto")

  @@map("settings")
}

model User {
  id                   String            @id @default(uuid())
  githubId             String?           @unique
  username             String            @unique
  displayName          String?
  email                String?           @unique
  avatarUrl            String?
  accessToken          String?
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  repositories         Repository[]
  teamMemberships      TeamMember[]
  ledProjects          Project[]         @relation("projectLead")
  workspaceMemberships WorkspaceMember[]
  projectAccess        ProjectAccess[]

  assignedTasks           Task[]                   @relation("assignedTasks")
  createdTasks            Task[]                   @relation("createdTasks")
  taskAssignments         TaskAssignee[]
  comments                Comment[]
  agentRuns               AgentRun[]
  notifications           Notification[]           @relation("notificationRecipient")
  notifyActions           Notification[]           @relation("notificationActor")
  activityLogs            ActivityLog[]
  settings                Settings?
  personalAccessTokens    PersonalAccessToken[]
  chatSessions            ChatSession[]
  chatMessages            ChatMessage[]
  chatToolCalls           ChatToolCall[]
  chatAttachments         ChatAttachment[]
  sentInvitations         Invitation[]             @relation("InvitedByUser")
  commentMentions         CommentMention[]         @relation("commentMentions")
  notificationPreferences NotificationPreference[]
  auditLogs               AuditLog[]
  sessions                Session[]

  // Two-Factor Authentication (TOTP)
  totpSecret           String?
  totpEnabled          Boolean  @default(false)
  backupCodes          String[]
  encryptionKeyVersion Int      @default(1)
  // W02b: highest TOTP time step (unix seconds / 30) already accepted. A code
  // is only accepted for a strictly later step, so a code cannot be replayed
  // inside its validity window. Advanced with a conditional UPDATE.
  totpLastUsedStep     Int?

  identities          Identity[]
  twoFactorChallenges TwoFactorChallenge[]
  emailChangeRequests EmailChangeRequest[]
  sseTickets          SseTicket[]
  desktopAuthCodes    DesktopAuthCode[]
  accountAuditLogs    AccountAuditLog[]
  executionAttempts   ExecutionAttempt[]

  @@map("users")
}

model PersonalAccessToken {
  id          String     @id @default(uuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  tokenHash   String     @unique
  tokenPrefix String
  scopes      String[]   @default(["read"])
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  createdAt   DateTime   @default(now())
  revokedAt   DateTime?
  // NULL means account-wide. A database trigger
  // (personal_access_tokens_revoke_on_unbind, migration
  // 20261026010000_w02b_auth_hardening) revokes a token whose workspaceId goes
  // from set to NULL — including through this SetNull — so deleting a
  // workspace by any path can never widen a bound token.
  workspaceId String?
  workspace   Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([tokenHash])
  @@index([workspaceId])
  @@map("personal_access_tokens")
}

model Repository {
  id            String    @id @default(uuid())
  githubRepoId  Int
  name          String
  fullName      String
  cloneUrl      String
  defaultBranch String    @default("main")
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  isActive      Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  projects      Project[]

  @@unique([userId, githubRepoId])
  @@map("repositories")
}

model Workspace {
  id                   String                @id @default(uuid())
  name                 String
  slug                 String                @unique
  plan                 String                @default("free")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  members              WorkspaceMember[]
  projects             Project[]
  tasks                Task[]
  chatSessions         ChatSession[]
  chatToolCalls        ChatToolCall[]
  invitations          Invitation[]
  ssoConfig            SSOConfig?
  auditLogs            AuditLog[]
  personalAccessTokens PersonalAccessToken[]
  chatBudget           ChatWorkspaceBudget?
  webhookEndpoints     WebhookEndpoint[]

  @@map("workspaces")
}

model SSOConfig {
  id                    String    @id @default(uuid())
  workspaceId           String    @unique
  provider              String    @default("oidc")
  issuerUrl             String
  clientId              String
  clientSecretEncrypted String
  allowedDomains        String[]
  enforced              Boolean   @default(false)
  domainVerifiedAt      DateTime?
  verificationToken     String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  workspace             Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@map("sso_configs")
}

model WorkspaceMember {
  id          String        @id @default(uuid())
  workspaceId String
  userId      String
  role        WorkspaceRole @default(member)
  invitedAt   DateTime      @default(now())
  joinedAt    DateTime?
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  chatBudget  ChatMemberBudget?

  @@unique([workspaceId, userId])
  @@index([userId])
  @@map("workspace_members")
}

model Team {
  id              String        @id @default(uuid())
  name            String
  key             String // e.g. "ENG", "DSN"
  description     String?
  color           String        @default("#6366f1")
  icon            String?
  private         Boolean       @default(false)
  inviteCode      String?       @unique
  nextIssueNumber Int           @default(1)
  projectId       String        @map("project_id")
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  members         TeamMember[]
  tasks           Task[]
  activityLogs    ActivityLog[]

  @@unique([projectId, key])
  @@index([projectId])
  @@map("teams")
}

model TeamMember {
  id        String   @id @default(uuid())
  teamId    String
  userId    String
  role      TeamRole @default(member)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
  @@index([userId])
  @@map("team_members")
}

model Project {
  id            String          @id @default(uuid())
  workspaceId   String?
  workspace     Workspace?      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  key           String?
  name          String
  description   String?
  status        ProjectStatus   @default(planned)
  color         String          @default("#6366f1")
  icon          String?
  startDate     DateTime?
  targetDate    DateTime?
  leadId        String?
  lead          User?           @relation("projectLead", fields: [leadId], references: [id], onDelete: SetNull)
  repositoryId  String?
  repository    Repository?     @relation(fields: [repositoryId], references: [id], onDelete: SetNull)
  localPath     String? // Absolute path to local folder (alternative to repo)
  repoUrl       String? // Original URL used to connect (for display)
  defaultAgent  String? // Default runner id for tasks in this project
  /// W11a: `{ verification: { policy, checks, autoDetect, repositoryChecks } }` (validated by execution-core parseProjectVerificationSettings).
  executionSettings Json?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  teams         Team[]
  tasks         Task[]
  labels        Label[]
  plans             Plan[]
  issueSchedules    IssueSchedule[]
  knowledgeEntries  KnowledgeEntry[]
  webhookEndpoints  WebhookEndpoint[]
  access        ProjectAccess[]
  activityLogs  ActivityLog[]
  chatSessions  ChatSession[]
  chatToolCalls ChatToolCall[]

  @@unique([workspaceId, key])
  @@index([workspaceId])
  @@map("linear_projects")
}

model ProjectAccess {
  id         String            @id @default(uuid())
  projectId  String
  userId     String
  permission ProjectPermission @default(full)
  grantedAt  DateTime          @default(now())
  project    Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([projectId, userId])
  @@index([userId])
  @@map("project_access")
}

model Comment {
  id              String           @id @default(uuid())
  taskId          String
  task            Task             @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  body            String
  mentions        String[]         @default([])
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  notifications   Notification[]
  commentMentions CommentMention[]

  @@index([taskId, createdAt])
  @@map("comments")
}

model ChatSession {
  id                String                 @id @default(uuid())
  userId            String
  user              User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId       String
  workspace         Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId         String?
  project           Project?               @relation(fields: [projectId], references: [id], onDelete: SetNull)
  title             String                 @default("New chat")
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  archivedAt        DateTime?
  messages          ChatMessage[]
  toolCalls         ChatToolCall[]
  toolConfirmations ChatToolConfirmation[]
  turnLease         ChatTurnLease?
  summaries         ChatSessionSummary[]

  @@index([userId, workspaceId, archivedAt, updatedAt])
  @@index([workspaceId])
  @@index([projectId])
  @@map("chat_sessions")
}

model ChatMessage {
  id           String          @id @default(uuid())
  sessionId    String
  session      ChatSession     @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId       String?
  user         User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  role         ChatMessageRole
  content      String?         @db.Text
  toolCalls    Json?
  toolCallId   String?
  toolName     String?
  createdAt    DateTime        @default(now())
  toolCallRows ChatToolCall[]
  // W18a: the turn that wrote the row, and how that turn ended. `incomplete`
  // marks the last assistant row of a turn that ended early (error, stop,
  // lease loss, budget); `errorCode` says why. `usage` is the turn's usage
  // summary, stored on the turn's last assistant row.
  turnId       String?
  incomplete   Boolean         @default(false)
  errorCode    String?
  finishReason String?
  usage        Json?

  attachments ChatAttachment[]

  @@index([sessionId, createdAt])
  @@index([userId, createdAt])
  @@map("chat_messages")
}

model ChatAttachment {
  id             String       @id @default(uuid())
  messageId      String?
  message        ChatMessage? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  filename       String
  mimeType       String
  url            String
  size           Int
  storageKey     String?
  checksumSha256 String?
  scanStatus     String       @default("pending")
  createdAt      DateTime     @default(now())

  @@index([messageId])
  @@index([userId, createdAt])
  @@map("chat_attachments")
}

model ChatToolCall {
  id                 String             @id @default(uuid())
  sessionId          String
  session            ChatSession        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  messageId          String?
  message            ChatMessage?       @relation(fields: [messageId], references: [id], onDelete: SetNull)
  userId             String?
  user               User?              @relation(fields: [userId], references: [id], onDelete: SetNull)
  workspaceId        String
  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  projectId          String?
  project            Project?           @relation(fields: [projectId], references: [id], onDelete: SetNull)
  // Journal key. Chat turns write our own per-turn identity here
  // (`<turnId>:<round>:<index>`); the provider's id is `providerToolCallId`.
  toolCallId         String
  toolName           String
  input              Json
  output             Json?
  status             ChatToolCallStatus @default(pending)
  startedAt          DateTime           @default(now())
  endedAt            DateTime?
  latencyMs          Int?
  errorCode          String?
  errorMessage       String?
  createdAt          DateTime           @default(now())
  turnId             String?
  providerToolCallId String?
  // read | write | destructive | external
  effect             String?

  @@unique([sessionId, toolCallId])
  @@index([sessionId, createdAt])
  @@index([toolName, createdAt])
  @@index([userId, createdAt])
  @@index([workspaceId, createdAt])
  @@map("chat_tool_calls")
}

// Server-issued, single-use approval for a destructive chat tool call. The
// code is shown to the user; it is redeemable only when the user's own next
// message carries it, before `expiresAt`, against an identical selection
// (`bindingHash`). Only the code's SHA-256 is stored.
model ChatToolConfirmation {
  id                 String      @id @default(uuid())
  sessionId          String
  session            ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId             String
  workspaceId        String
  projectId          String?
  toolName           String
  codeHash           String      @unique
  bindingHash        String
  selection          Json
  issuedTurnId       String?
  issuedToolCallId   String
  expiresAt          DateTime
  consumedAt         DateTime?
  consumedTurnId     String?
  consumedToolCallId String?
  createdAt          DateTime    @default(now())
  // The user dismissed the preview: the code can no longer be redeemed.
  revokedAt          DateTime?
  revokedById        String?

  @@index([sessionId, createdAt])
  @@index([expiresAt])
  @@map("chat_tool_confirmations")
}

// W18a durable single writer: at most one live turn per chat session across
// API replicas. A turn acquires the row (insert, or take over a released or
// expired lease, bumping `fence`), renews it while it runs, and every
// transcript write is conditional on (turnId, fence) still holding it.
model ChatTurnLease {
  sessionId  String      @id
  session    ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  turnId     String
  fence      Int
  holder     String
  acquiredAt DateTime
  renewedAt  DateTime
  expiresAt  DateTime
  releasedAt DateTime?

  @@map("chat_turn_leases")
}

// Summarizing compaction (audit record + stored summary): the oldest
// `coveredMessages` rows of a session, summarised when they fell out of the
// history window. One row per attempt; failed attempts are kept (content NULL).
// Incremental: a summary extends `previousSummaryId` with the rows after it.
model ChatSessionSummary {
  id                String      @id @default(uuid())
  sessionId         String
  session           ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  coveredMessages   Int
  previousSummaryId String?
  fromMessageId     String?
  throughMessageId  String?
  throughCreatedAt  DateTime?
  sourceMessages    Int
  sourceHash        String
  content           String?     @db.Text
  // succeeded | failed
  status            String
  errorCode         String?
  provider          String
  model             String
  turnId            String?
  invocationId      String?
  inputChars        Int
  outputChars       Int
  createdAt         DateTime    @default(now())

  @@index([sessionId, coveredMessages])
  @@map("chat_session_summaries")
}

// W15 chat budgets (admin overrides). NULL = inherit the operator default
// (CHAT_BUDGET_* env). Operator defaults are ceilings: a workspace can only
// tighten them. Calendar-month (UTC) periods.
model ChatWorkspaceBudget {
  workspaceId              String    @id
  workspace                Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  monthlyUsdLimit          Decimal?  @db.Decimal(12, 6)
  monthlyTokenLimit        Int?
  perUserMonthlyUsdLimit   Decimal?  @db.Decimal(12, 6)
  perUserMonthlyTokenLimit Int?
  // block | allow (allow = proceed with a warning when cost is unknown)
  unknownCostPolicy        String?
  updatedById              String?
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt

  @@map("chat_workspace_budgets")
}

// Per-member override of the workspace's per-user default. Removed with the
