  stopCode         String?
  expiresAt        DateTime
  createdAt        DateTime  @default(now())
  settledAt        DateTime?

  @@index([workspaceId, status, expiresAt])
  @@map("chat_budget_reservations")
}

// Append-only ledger: one row per model invocation attempt (chat rounds,
