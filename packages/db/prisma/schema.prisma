  @@map("chat_member_budgets")
}

// Budget held for a running turn (reserved before the first model call,
// extended between rounds, settled at the end). Admission counts spent
// (model_usage) + the unconsumed part of active, unexpired reservations.
// Ledger-like: no foreign keys, rows outlive their session.
model ChatBudgetReservation {
  id               String    @id @default(uuid())
  workspaceId      String
  userId           String
  sessionId        String?
  turnId           String    @unique
